root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,h}]
indent_size = 4
max_line_length = 100

[*.py]
indent_size = 4
max_line_length = 100

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
indent_size = 2
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[{CMakeLists.txt,*.cmake}]
indent_size = 2

[Makefile]
indent_style = tab

# KiCad and CubeMX write these themselves. Leave their formatting alone.
[*.{kicad_sch,kicad_pcb,kicad_pro,kicad_sym,kicad_mod,ioc}]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset

[*.bat]
end_of_line = crlf
